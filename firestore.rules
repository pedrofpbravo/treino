rules_version = '2';

// One personal account. Two layers:
// 1. In the Firebase console, disable sign-up (Authentication > Settings >
//    User actions > "Enable create (sign-up)" off), so no one can create
//    accounts with the public web key.
// 2. Optionally pin everything to your own UID below: replace PASTE_UID
//    with your user's UID (Authentication > Users) and uncomment that line,
//    commenting out the generic one.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // allow read, write: if request.auth != null;
      allow read, write: if request.auth != null && request.auth.uid == "GjkTsbrRKhWrdk2VAC4xop5xBhu1";
    }
  }
}
